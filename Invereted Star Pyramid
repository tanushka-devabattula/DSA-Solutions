import java.util.*;

public class Main {
    public static void main(String[] args) {
    	Scanner s=new Scanner(System.in);
	int n=s.nextInt();
	for(int i=n;i>0;i--)
	{
	    for(int spaces=n-i;spaces>=1;spaces--)
	    System.out.print(" ");
	    for(int j=2*i-1;j>=1;j--)
	    {
	    System.out.print("*");
	    }
	    System.out.println();
	}



    }
}
